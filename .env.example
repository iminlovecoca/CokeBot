TOKEN=discord_bot_token
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/dbname
OWNER_ID=discord_user_id
GEMINI_API_KEY=gemini_api_key

# Optional: configure multiple football leagues for /bet.
# With football-data.org, use competition codes like PL, CL, WC.
FOOTBALL_BET_PROVIDER=football-data
FOOTBALL_BET_API_BASE_URL=https://api.football-data.org/v4
FOOTBALL_BET_COMPETITIONS_JSON=[{"key":"pl","name":"Premier League","id":"PL"},{"key":"cl","name":"Champions League","id":"CL"},{"key":"wc","name":"World Cup","id":"WC","season":"2026"}]
FOOTBALL_BET_SCORE_MULTIPLIER=6
